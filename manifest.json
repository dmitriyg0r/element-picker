{
  "manifest_version": 3,
  "name": "__MSG_extension_name__",
  "version": "1.3.8",
  "description": "__MSG_extension_description__",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "__MSG_extension_name__",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "i18n.js",
        "shortcuts.js",
        "capture.js",
        "picker-styles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en"
}
