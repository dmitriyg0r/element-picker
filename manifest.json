{
  "manifest_version": 3,
  "name": "Выбор элемента",
  "version": "1.3.5",
  "description": "Отмечайте элементы страницы, добавляйте заметки и копируйте их. Работает локально.",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Выбор элемента",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "shortcuts.js",
        "capture.js",
        "picker-styles.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
